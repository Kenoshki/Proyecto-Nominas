# Conexión a MySQL. En Railway: usar la URL del plugin MySQL (se normaliza a mysql+pymysql://).
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/nombre_de_base

# Orígenes permitidos por CORS, separados por coma, SIN barra final ni "*".
# Producción: la URL pública del Frontend, p. ej. https://nomina-frontend.up.railway.app
ORIGENES=http://localhost:5173

# Secreto para firmar los JWT (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Duración de la sesión en minutos (por defecto 480 = 8 h).
JWT_EXPIRA_MINUTOS=480

# "produccion" (valor por defecto si se omite) desactiva /docs y /openapi.json.
# En local usa ENTORNO=desarrollo para tener Swagger.
ENTORNO=desarrollo

# Saltos de proxy de confianza delante de la app. Railway = 1 (el limitador usa la IP que añadió Railway
# en X-Forwarded-For). En local déjalo en 0: el encabezado del cliente se ignora.
PROXY_HOPS=0

# Administrador inicial: si la tabla de usuarios está vacía, se crea al arrancar.
# También lo usa `python create_admin.py` para crear/restablecer al admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
